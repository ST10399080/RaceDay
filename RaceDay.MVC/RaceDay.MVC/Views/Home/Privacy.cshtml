@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Header -->
            <div class="text-center mb-5">
                <span class="badge bg-primary mb-3">RACEDAY</span>
                <h1 class="fw-bold display-5">Privacy Policy</h1>
                <p class="text-muted">
                    Your privacy matters to us.
                </p>
                <p class="text-muted small">
                    Last updated: 10 November 2026
                </p>
            </div>

            <!-- Introduction -->
            <section class="mb-4">
                <h3 class="fw-bold">1. Introduction</h3>
                <p>
                    RaceDay respects your privacy and is committed to
                    protecting your personal information. This Privacy
                    Policy explains how we collect, use, store and protect
                    your information when you access or use the RaceDay
                    website and its services.
                </p>
                <p>
                    RaceDay aims to handle personal information in
                    accordance with applicable data protection laws,
                    including the Protection of Personal Information Act
                    (POPIA) of South Africa.
                </p>
            </section>

            <!-- Information Collection -->
            <section class="mb-4">
                <h3 class="fw-bold">2. Information We Collect</h3>
                <p>
                    When you register for an account or use RaceDay,
                    we may collect the following information:
                </p>
                <ul>
                    <li>Full name and username.</li>
                    <li>Email address and contact information.</li>
                    <li>Account login credentials, stored securely.</li>
                    <li>User role, such as Participant or Organiser.</li>
                    <li>Event enrolment and participation information.</li>
                    <li>Race results, finishing times and positions.</li>
                    <li>Event information and uploaded event images.</li>
                </ul>
                <p>
                    We may also collect technical information required
                    to operate, maintain and secure the website.
                </p>
            </section>

            <!-- Use of Information -->
            <section class="mb-4">
                <h3 class="fw-bold">3. How We Use Your Information</h3>
                <p>
                    Personal information is used for legitimate
                    RaceDay platform purposes, including:
                </p>
                <ul>
                    <li>Creating and managing user accounts.</li>
                    <li>Authenticating users and controlling access.</li>
                    <li>Allowing participants to enrol in sporting events.</li>
                    <li>Allowing organisers to create and manage events.</li>
                    <li>Recording and displaying race results.</li>
                    <li>Providing account and event-related functionality.</li>
                    <li>Maintaining website security and preventing misuse.</li>
                    <li>Improving the performance and functionality of RaceDay.</li>
                </ul>
            </section>

            <!-- Sharing -->
            <section class="mb-4">
                <h3 class="fw-bold">4. Sharing of Information</h3>
                <p>
                    RaceDay does not sell users' personal information.
                    Information may be made available to authorised users
                    where necessary for platform functionality.
                </p>
                <p>
                    For example, event organisers may access relevant
                    participant enrolment information, while participants
                    may access their own enrolments and race results.
                </p>
                <p>
                    Information may also be disclosed where required by
                    law or where necessary to protect the security and
                    legitimate interests of the platform and its users.
                </p>
            </section>

            <!-- Security -->
            <section class="mb-4">
                <h3 class="fw-bold">5. Data Security</h3>
                <p>
                    RaceDay takes reasonable technical and organisational
                    measures to protect personal information against
                    unauthorised access, loss, misuse, alteration or
                    disclosure.
                </p>
                <p>
                    These measures may include authentication,
                    role-based access controls, secure password storage
                    and protected communication channels.
                </p>
                <p>
                    However, no internet-based system can guarantee
                    complete security.
                </p>
            </section>

            <!-- Retention -->
            <section class="mb-4">
                <h3 class="fw-bold">6. Data Retention</h3>
                <p>
                    Personal information is retained only for as long
                    as reasonably necessary to fulfil the purposes for
                    which it was collected, comply with applicable
                    legal obligations and resolve disputes.
                </p>
                <p>
                    When information is no longer required, reasonable
                    steps will be taken to securely delete or de-identify it.
                </p>
            </section>

            <!-- User Rights -->
            <section class="mb-4">
                <h3 class="fw-bold">7. Your Privacy Rights</h3>
                <p>
                    Subject to applicable law, including POPIA,
                    users may have the right to:
                </p>
                <ul>
                    <li>Request access to their personal information.</li>
                    <li>Request correction of inaccurate information.</li>
                    <li>Request deletion of information where legally permitted.</li>
                    <li>Object to certain forms of personal information processing.</li>
                    <li>Raise concerns about how their information is handled.</li>
                </ul>
            </section>

            <!-- Cookies -->
            <section class="mb-4">
                <h3 class="fw-bold">8. Cookies and Website Data</h3>
                <p>
                    RaceDay may use cookies or similar technologies
                    where necessary for website functionality, such as
                    maintaining login sessions and remembering user
                    authentication states.
                </p>
                <p>
                    Users can manage cookies through their browser
                    settings. Disabling certain cookies may affect
                    website functionality.
                </p>
            </section>

            <!-- Third Parties -->
            <section class="mb-4">
                <h3 class="fw-bold">9. Third-Party Services</h3>
                <p>
                    RaceDay may rely on third-party infrastructure or
                    services to support website hosting, database
                    management and other technical functionality.
                </p>
                <p>
                    Where third-party services process personal
                    information on behalf of RaceDay, appropriate
                    safeguards should be implemented.
                </p>
            </section>

            <!-- Children -->
            <section class="mb-4">
                <h3 class="fw-bold">10. Children's Privacy</h3>
                <p>
                    RaceDay is not intended to collect children's
                    personal information without the necessary
                    authorisation and safeguards required by applicable
                    law.
                </p>
                <p>
                    Where personal information of a child is processed,
                    the applicable legal requirements must be followed.
                </p>
            </section>

            <!-- Changes -->
            <section class="mb-4">
                <h3 class="fw-bold">11. Changes to This Policy</h3>
                <p>
                    RaceDay may update this Privacy Policy from time
                    to time to reflect changes in platform functionality,
                    security practices or applicable legal requirements.
                </p>
                <p>
                    Updated versions will be published on this page
                    with a revised update date.
                </p>
            </section>

            <!-- Contact -->
            <section class="mb-4">
                <h3 class="fw-bold">12. Contact and Privacy Enquiries</h3>
                <p>
                    If you have questions, concerns or requests relating
                    to this Privacy Policy or the handling of your
                    personal information, please contact the RaceDay
                    platform administrator through the available
                    website contact channels.
                </p>
            </section>

            <!-- Footer -->
            <div class="border-top pt-4 mt-5 text-center">
                <p class="text-muted small mb-1">
                    Your information. Your privacy. Our responsibility.
                </p>
                <p class="fw-bold mb-0">
                    RaceDay &mdash; Every Race. Every Athlete. One Platform.
                </p>
            </div>

        </div>
    </div>
</div>
