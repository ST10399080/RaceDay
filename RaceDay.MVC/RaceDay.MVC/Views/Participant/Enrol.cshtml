@model List<RaceDay.MVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Select Event Category";
}

<div class="container py-4">
    <h2 class="mb-3">Select Your Event Category</h2>

    <p class="text-muted">
        Choose the category you would like to enter.
    </p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No categories are currently available for this event.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                @foreach (var category in Model)
                {
                    <div class="border rounded p-3 mb-3">
                        <h5 class="mb-2">@category.CategoryName</h5>

                        <form asp-controller="Participant"
                              asp-action="CreateEnrolment"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="EventID"
                                   value="@category.EventID" />

                            <input type="hidden"
                                   name="CategoryID"
                                   value="@category.CategoryID" />

                            <button type="submit" class="btn btn-raceday">
                                Enrol in This Category
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }

    <a asp-controller="Participant"
       asp-action="Events"
       class="btn btn-outline-secondary mt-3">
        Back to Events
    </a>
</div>