@model List<RaceDay.MVC.Models.OrganiserEventViewModel>

@{
    ViewData["Title"] = "Explore Events";
    var today = DateTime.Today;
}

<div class="container-fluid py-4">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-4">
        <h2 class="fw-bold">Explore Sporting Events</h2>
        <p class="text-muted">
            Discover upcoming races and find your next challenge.
        </p>
    </div>

    <div class="row g-4">

        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                var isUpcoming = item.EventDate.Date >= today;

                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between
                                align-items-start mb-3">
                                <span class="badge bg-primary">
                                    @item.EventType
                                </span>

                                @if (isUpcoming)
                                {
                                    <span class="badge status-confirmed">
                                        Upcoming
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Completed
                                    </span>
                                }
                            </div>

                            <h5 class="fw-bold mb-3">
                                @item.EventName
                            </h5>

                            <p class="text-muted">
                                @item.Description
                            </p>

                            <hr />

                            <p class="mb-2">
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p class="mb-2">
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p class="mb-0">
                                <strong>Distance:</strong>
                                @item.Distance km
                            </p>

                        </div>

                        <div class="card-footer bg-white border-0 p-4 pt-0">
                            @if (isUpcoming)
                            {
                                <button type="button"
                                        class="btn btn-raceday w-100"
                                        disabled>
                                    Enrolment Coming Soon
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-outline-secondary w-100"
                                        disabled>
                                    Event Completed
                                </button>
                            }
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <h5 class="fw-bold">No Events Available</h5>
                        <p class="text-muted mb-0">
                            There are currently no sporting events to display.
                            Please check again later.
                        </p>
                    </div>
                </div>
            </div>
        }

    </div>

</div>