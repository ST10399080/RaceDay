@model List<RaceDay.MVC.Models.OrganiserEventViewModel>

@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Welcome to RaceDay!</h2>
        <p class="text-muted">
            Discover upcoming races, manage your enrolments and track your racing journey.
        </p>
    </div>

    <!-- Participant Summary Cards -->

    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-1">My Enrolments</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="fw-bold mb-0">—</h3>
                        <span class="fs-2">🏃</span>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <span class="text-primary fw-semibold">Registered Events</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-1">Upcoming Races</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="fw-bold mb-0">—</h3>
                        <span class="fs-2">📅</span>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <span class="text-success fw-semibold">Future Events</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-1">Completed Races</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="fw-bold mb-0">—</h3>
                        <span class="fs-2">🏆</span>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <span class="text-warning fw-semibold">Race History</span>
                </div>
            </div>
        </div>

    </div>

    <!-- Upcoming Events -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Upcoming Events</h5>

            <a asp-controller="Participant"
               asp-action="Events"
               class="btn btn-raceday btn-sm">
                Explore Events
            </a>
        </div>

        <div class="card-body">
            @if (Model.Any())
            {
                <div class="row g-3">
                    @foreach (var item in Model.Take(3))
                    {
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <h6 class="fw-bold">@item.EventName</h6>

                                <p class="text-muted small mb-2">
                                    @item.EventDate.ToString("dd MMM yyyy")
                                </p>

                                <p class="mb-2">
                                    <strong>Location:</strong> @item.Location
                                </p>

                                <p class="mb-0">
                                    <strong>Distance:</strong> @item.Distance km
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    There are currently no upcoming sporting events.
                    Please check again later.
                </p>
            }
        </div>

    </div>

    <!-- Recent Results -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">My Recent Results</h5>
        </div>

        <div class="card-body">
            <p class="text-muted mb-0">
                Your completed races and finishing positions will appear here.
            </p>
        </div>

    </div>

</div>
