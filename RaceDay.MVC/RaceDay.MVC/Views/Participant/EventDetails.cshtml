@model RaceDay.MVC.Models.OrganiserEventViewModel

@{
    ViewData["Title"] = "Event Details";
    var isUpcoming = Model.EventDate.Date >= DateTime.Today;
}

<div class="container py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="mb-4">
        <a asp-controller="Participant"
           asp-action="Events"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Events
        </a>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4 p-md-5">

            <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-2 mb-3">

                <span class="badge bg-primary">
                    @Model.EventType
                </span>

                @if (isUpcoming)
                {
                    <span class="badge status-confirmed">
                        Upcoming
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Completed
                    </span>
                }

            </div>

            <h1 class="fw-bold mb-3">
                @Model.EventName
            </h1>

            <p class="text-muted fs-5 mb-4">
                @Model.Description
            </p>

            <hr />

            <h5 class="fw-bold mb-3">Event Information</h5>

            <div class="row g-4">

                <div class="col-md-6">
                    <p class="text-muted mb-1">Event Date</p>
                    <h6 class="fw-semibold">
                        @Model.EventDate.ToString("dd MMMM yyyy")
                    </h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Location</p>
                    <h6 class="fw-semibold">
                        @Model.Location
                    </h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Distance</p>
                    <h6 class="fw-semibold">
                        @Model.Distance km
                    </h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Event Type</p>
                    <h6 class="fw-semibold">
                        @Model.EventType
                    </h6>
                </div>

            </div>

            <hr class="my-4" />

            @if (isUpcoming)
            {
                <a asp-controller="Participant"
                   asp-action="Enrol"
                   asp-route-id="@Model.EventID"
                   class="btn btn-raceday">
                    Enrol in This Event
                </a>
            }
            else
            {
                <button type="button"
                        class="btn btn-outline-secondary btn-lg"
                        disabled>
                    Event Completed
                </button>
            }

        </div>
    </div>
</div>
