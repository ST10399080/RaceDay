@model List<RaceDay.MVC.Models.ParticipantEnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container py-4">

    <div class="mb-4">
        <h2>My Enrolments</h2>
        <p class="text-muted">
            View your sporting event registrations and their current status.
        </p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h5>No Enrolments Yet</h5>
                <p class="text-muted">
                    You haven't enrolled in any sporting events yet.
                </p>

                <a asp-controller="Participant"
                   asp-action="Events"
                   class="btn btn-raceday">
                    Explore Events
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Category</th>
                                <th>Enrolment Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.EventName</td>
                                    <td>@item.CategoryName</td>
                                    <td>
                                        @item.EnrolmentDate.ToLocalTime().ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        @if (item.Status == "Approved")
                                        {
                                            <span class="badge status-confirmed">
                                                Approved
                                            </span>
                                        }
                                        else if (item.Status == "Pending")
                                        {
                                            <span class="badge status-pending">
                                                Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    }

</div>