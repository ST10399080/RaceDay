@model List<RaceDay.MVC.Models.OrganiserEventViewModel>

@{
    ViewData["Title"] = "Organiser Dashboard";

    var today = DateTime.Today;
    var upcomingEvents = Model.Count(e => e.EventDate.Date >= today);
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Organiser Dashboard</h2>
        <p class="text-muted">
            Manage your events, monitor enrolments and track upcoming races.
        </p>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Events Created</p>
                            <h3 class="fw-bold mb-0">@Model.Count</h3>
                        </div>
                        <div class="fs-2">🏁</div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <span class="text-primary fw-semibold">Your Events</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Total Enrolments</p>
                            <h3 class="fw-bold mb-0">@ViewBag.TotalEnrolments</h3>
                        </div>
                        <div class="fs-2">👥</div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <span class="text-success fw-semibold">Participant Enrolments</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Upcoming Events</p>
                            <h3 class="fw-bold mb-0">@upcomingEvents</h3>
                        </div>
                        <div class="fs-2">📅</div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <span class="text-warning fw-semibold">Scheduled Races</span>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Your Events</h5>
        </div>

        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Event</th>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Distance</th>
                                <th>Enrolments</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.EventName</td>
                                    <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.Location</td>
                                    <td>@item.Distance km</td>
                                    <td>
                                        @{
                                            var enrolmentCounts =
                                                ViewBag.EnrolmentCounts as Dictionary<int, int>;
                                        }

                                        @(enrolmentCounts != null &&
                                          enrolmentCounts.ContainsKey(item.EventID)
                                            ? enrolmentCounts[item.EventID]
                                            : 0)
                                    </td>
                                    <td>
                                        @if (item.EventDate.Date >= today)
                                        {
                                            <span class="badge status-confirmed">
                                                Upcoming
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Completed
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    You haven't created any events yet.
                </p>
            }
        </div>
        </div>
    </div>

</div>
