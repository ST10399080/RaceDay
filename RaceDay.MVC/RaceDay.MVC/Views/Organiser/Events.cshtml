@{
    ViewData["Title"] = "Manage Events";
}

<div class="container-fluid py-4">

    <!-- Page Heading -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

        <div>
            <h2 class="fw-bold">Event Management</h2>
            <p class="text-muted mb-0">
                Create, manage and organise your sporting events.
            </p>
        </div>

        <button type="button" class="btn btn-raceday">
            + Create New Event
        </button>

    </div>

    <!-- Event Summary -->

    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <p class="text-muted mb-1">Total Events</p>
                    <h3 class="fw-bold mb-0">—</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <p class="text-muted mb-1">Upcoming Events</p>
                    <h3 class="fw-bold mb-0">—</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <p class="text-muted mb-1">Completed Events</p>
                    <h3 class="fw-bold mb-0">—</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- Events Table -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Your Sporting Events</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Event Type</th>
                            <th>Enrolments</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                No events to display yet.
                                <br />
                                Your created events will appear here.
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

