@model List<RaceDay.MVC.Models.OrganiserEventViewModel>

@{
    ViewData["Title"] = "Manage Events";

    var today = DateTime.Today;
    var upcomingEvents = Model.Count(e => e.EventDate.Date >= today);
    var completedEvents = Model.Count(e => e.EventDate.Date < today);
}

<div class="container-fluid py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Heading -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold">Event Management</h2>
            <p class="text-muted mb-0">
                Create, manage and organise your sporting events.
            </p>
        </div>


    </div>

    <!-- Event Summary -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <p class="text-muted mb-1">Total Events</p>
                    <h3 class="fw-bold mb-0">@Model.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <p class="text-muted mb-1">Upcoming Events</p>
                    <h3 class="fw-bold mb-0">@upcomingEvents</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <p class="text-muted mb-1">Completed Events</p>
                    <h3 class="fw-bold mb-0">@completedEvents</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- Events Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Your Sporting Events</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Distance</th>
                            <th>Event Type</th>
                            <th>Enrolments</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                var isUpcoming = item.EventDate.Date >= today;

                                <tr>
                                    <td>
                                        <strong>@item.EventName</strong>
                                    </td>

                                    <td>
                                        @item.EventDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>@item.Location</td>

                                    <td>@item.Distance km</td>

                                    <td>@item.EventType</td>

                                    <td>—</td>

                                    <td>
                                        @if (isUpcoming)
                                        {
                                            <span class="badge status-confirmed">
                                                Upcoming
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Completed
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="Organiser"
                                           asp-action="EditEvent"
                                           asp-route-id="@item.EventID"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-controller="Organiser"
                                           asp-action="Enrolments"
                                           asp-route-id="@item.EventID"
                                           class="btn btn-sm btn-outline-success">
                                            View Enrolments
                                        </a>

                                        <form asp-controller="Organiser"
                                              asp-action="DeleteEvent"
                                              asp-route-id="@item.EventID"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this event?');">
                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center py-5 text-muted">
                                    No events to display yet.
                                    <br />
                                    Your created events will appear here.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
