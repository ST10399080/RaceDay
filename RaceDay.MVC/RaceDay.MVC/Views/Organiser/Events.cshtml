@model List<RaceDay.MVC.Models.OrganiserEventViewModel>

@{
    ViewData["Title"] = "Manage Events";

    var today = DateTime.Today;
    var upcomingEvents = Model.Count(e => e.EventDate.Date >= today);
    var completedEvents = Model.Count(e => e.EventDate.Date < today);
}

<div class="container-fluid py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Heading -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge bg-primary mb-2">ORGANISER PORTAL</span>
            <h2 class="fw-bold mb-1">Event Management</h2>
            <p class="text-muted mb-0">
                Create, manage and organise your sporting events.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>
            Create New Event
        </a>
    </div>

    <!-- Event Summary -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Total Events</p>
                            <h3 class="fw-bold mb-0">@Model.Count</h3>
                        </div>
                        <div class="fs-2">🏁</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Upcoming Events</p>
                            <h3 class="fw-bold text-success mb-0">@upcomingEvents</h3>
                        </div>
                        <div class="fs-2">📅</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Completed Events</p>
                            <h3 class="fw-bold text-secondary mb-0">@completedEvents</h3>
                        </div>
                        <div class="fs-2">🏆</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Events Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0">Your Sporting Events</h5>
                <small class="text-muted">
                    Manage your events and participant enrolments.
                </small>
            </div>

            <span class="badge bg-primary rounded-pill">
                @Model.Count Events
            </span>
        </div>

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Event</th>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Distance</th>
                                <th>Event Type</th>
                                <th>Enrolments</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                var isUpcoming = item.EventDate.Date >= today;
                                var enrolmentCount = 0;

                                if (ViewBag.EnrolmentCounts != null)
                                {
                                    var counts = ViewBag.EnrolmentCounts
                                    as IDictionary<int, int>;

                                    if (counts != null &&
                                    counts.TryGetValue(item.EventID, out var count))
                                    {
                                        enrolmentCount = count;
                                    }
                                }

                                <tr>
                                    <td>
                                        <strong>@item.EventName</strong>
                                    </td>

                                    <td>
                                        @item.EventDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>@item.Location</td>

                                    <td>@item.Distance km</td>

                                    <td>@item.EventType</td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @enrolmentCount
                                        </span>
                                    </td>

                                    <td>
                                        @if (isUpcoming)
                                        {
                                            <span class="badge bg-success">
                                                Upcoming
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Completed
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">

                                            <a asp-controller="Organiser"
                                               asp-action="EditEvent"
                                               asp-route-id="@item.EventID"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil-square me-1"></i>
                                                Edit
                                            </a>

                                            <a asp-controller="Organiser"
                                               asp-action="Enrolments"
                                               asp-route-id="@item.EventID"
                                               class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-people me-1"></i>
                                                Enrolments
                                            </a>

                                            <form asp-controller="Organiser"
                                                  asp-action="DeleteEvent"
                                                  asp-route-id="@item.EventID"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this event?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash me-1"></i>
                                                    Delete
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="display-3 mb-3">🏁</div>

                    <h4 class="fw-bold">No Events Yet</h4>

                    <p class="text-muted mb-4">
                        You haven't created any sporting events.
                        Start by creating your first event.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="CreateEvent"
                       class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>
                        Create Your First Event
                    </a>

                </div>
            }

        </div>
    </div>

</div>
